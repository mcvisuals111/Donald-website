# ---------------------------------------------------------------------------
# Stripe. Server-side only. Never expose the secret key to a client component.
# Test keys start with sk_test_ / pk_test_.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx

# Optional: pre-created Stripe Price IDs. If unset, Checkout Sessions are
# created with inline price_data at $100 / $200 USD, which works out of the box.
STRIPE_PRICE_ONE_HOUR=
STRIPE_PRICE_TWO_HOURS=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Absolute origin used to build Stripe success/cancel URLs and page metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Cal.com. Public by design — this is just the booking link namespace.
# e.g. "donaldmackenzie/lesson"
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CAL_LINK=donaldmackenzie/lesson

# Contact address shown in the footer.
NEXT_PUBLIC_CONTACT_EMAIL=donald@donaldmackenzie.trade
